# Copy this file to .env.local (never commit .env.local).
# Every value is optional for the build to succeed, but the site is only
# complete once the WhatsApp number is set.

# Public base URL used in metadata, Open Graph tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://branditchina.com

# Destination WhatsApp number in international format, digits only, no "+",
# no spaces, no leading zeros. Example for a UK mobile: 447700900123
# Example for a Thai mobile: 66812345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles. Leave any of these blank to hide that link site-wide.
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/lewis-m-27b80550/
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Optional public contact email shown in the privacy policy and footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional founder film. Place the file in /public/video and reference it here
# (e.g. /video/founder.mp4). Leave blank to show the portrait still.
NEXT_PUBLIC_FOUNDER_VIDEO=
