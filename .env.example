# Copy this file to .env.local and fill in values as needed.
# None of these are required for the site to build or run — without them,
# the contact form falls back to opening the visitor's email client.

# Base URL used in metadata, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://lewisandpartners.asia

# Optional: an endpoint the contact form POSTs FormData to (e.g. a Formspree
# form endpoint, or your own serverless function). See README "Contact form
# backend" for recommended providers.
NEXT_PUBLIC_FORM_ENDPOINT=
